DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
PORT=3000
FRONTEND_ORIGIN=https://your-frontend.onrender.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://your-api.onrender.com/api/auth/github/callback
R2_SESSION_SECRET=generate-a-long-random-value
ALGOMA_EMAIL_DOMAINS=algomau.ca
VERIFICATION_CODE_TTL_MINUTES=30
RESEND_API_KEY=
VERIFICATION_FROM_EMAIL=

# Preferred Google Apps Script mailer (see ops/google-mailer/README.md).
# When either Google setting is present, both must be valid.
GOOGLE_MAILER_URL=
GOOGLE_MAILER_SECRET=

# Optional Mailjet API provider (sender must be validated in Mailjet).
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
