{
  "name": "cosc3506-phase0-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Verification tools for the COSC 3506 Phase 0 production pipeline bootcamp",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm --prefix frontend run build",
    "check:repo": "node scripts/verify-phase0.mjs repo",
    "check:final": "node scripts/verify-phase0.mjs repo --require-tag phase0-complete --production",
    "test": "node --test tests/*.test.mjs"
  }
}
